# ==============================================================================
# Octop Official Standard Environment Configuration
# ==============================================================================

# Server Network & Logging
OCTOP_PORT=8088
OCTOP_LOG_LEVEL=info

# Admin Account Initialization (Optional - Leave blank to use web setup wizard)
OCTOP_ADMIN_USERNAME=admin
OCTOP_ADMIN_DISPLAY_NAME=Administrator
OCTOP_DEFAULT_PASSWORD=

# Model Gateway (BYOK: OpenAI, SenseNova, DeepSeek, Qwen, Ollama)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://token.sensenova.cn/v1
OPENAI_MODEL=sensenova-6.8-flash-lite

# ------------------------------------------------------------------------------
# Enterprise IM Channels (Configure the platforms you wish to activate)
# ------------------------------------------------------------------------------

# 1. 飞书 (Lark) 自建应用凭据
OCTOP_FEISHU_APP_ID=
OCTOP_FEISHU_APP_SECRET=

# 2. 企业微信 (WeCom) 自建应用凭据
OCTOP_WECOM_CORP_ID=
OCTOP_WECOM_AGENT_ID=
OCTOP_WECOM_SECRET=

# 3. 钉钉 (DingTalk) 内部机器人凭据
OCTOP_DINGTALK_CLIENT_ID=
OCTOP_DINGTALK_CLIENT_SECRET=
