# =================================================================
# EasyBot Enterprise Turnkey Configuration
# Powered by Big-Tech Backing: Tencent WeKnora, CubeSandbox, Octop Gateway
# =================================================================

# --- Core Service & Domain Selection ---
PORT=4100
NODE_ENV=production
# Domain Packs to load: 'generic' (default, 100% clean enterprise), 'edu', 'mfg', or 'all'
EASYBOT_PACKS=generic

# --- Model Gateway ---
OPENAI_API_KEY=sk-your-llm-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- MicroVM Sandbox (TencentCloud CubeSandbox) ---
# Default connects to the bundled microVM container
CUBESANDBOX_URL=http://127.0.0.1:49982
CUBESANDBOX_API_KEY=

# --- Enterprise RAG Cluster (Tencent WeKnora) ---
# Default connects to the bundled ParadeDB/pgvector WeKnora cluster
WEKNORA_URL=http://127.0.0.1:8000
WEKNORA_API_KEY=
WEKNORA_EMBEDDING_MODEL=bge-large-zh-v1.5

# --- Enterprise IM Bridge (TencentCloud Octop Gateway) ---
# Default connects to the bundled Octop IM bridge
OCTOP_GATEWAY_URL=http://127.0.0.1:5000
OCTOP_API_KEY=

# Enterprise IM Integration Credentials (Optional)
WECOM_CORP_ID=
WECOM_AGENT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Enterprise Identity (LDAP / Active Directory) ---
LDAP_URL=ldap://127.0.0.1:389
LDAP_SEARCH_BASE=dc=enterprise,dc=com
LDAP_SIMULATION_MODE=false
